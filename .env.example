# ---- Gnani (app.gnani.ai) --------------------------------------------------
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# Prisma STT
PRISMA_MODEL=prisma-v3.0
PRISMA_LANGUAGE=indic-auto
PRISMA_FORMAT=codemix
# Upload the degraded line audio at 8 kHz; falls back to 16 kHz automatically if rejected
PRISMA_UPLOAD_SR=8000

# Timbre TTS + voice cloning
TIMBRE_MODEL=timbre-v2.5
TIMBRE_VC_MODEL=vachana-vc-v1
TIMBRE_SAMPLE_RATE=16000
# Optional: restrict generated callers to these voices (default: every v2.5 voice, matched by language;
# see chakravyuh/voices.py and docs.gnani.ai/api/TTS/available-voices)
TIMBRE_VOICES=
# multipart field name for the clone sample (docs: audio_file)
VC_UPLOAD_FIELD=audio_file
# Empty = a professional female voice per reply language (Kaveri en, Ambuja hi, Vedika ta, Saanvi kn, ...)
REFBOT_VOICE=

# ---- Credit ledger (hard cap) ----------------------------------------------
CREDIT_CAP=4000
# Third-party estimates; replace with the real numbers from your usage page after `chakravyuh smoke`
RATE_STT_PER_MIN=0.5
RATE_TTS_PER_1K_CHARS=2.8
RATE_VC_PER_CALL=1.0
# A run estimated above this needs --yes
CONFIRM_ABOVE=200
# Free-tier LLMs (Gemini/Groq) rate-limit per minute: keep this at 2. Raise to 6 on paid or self-hosted LLMs.
CONCURRENCY=2

# ---- LLM roles (any OpenAI-compatible endpoint) ----------------------------
# Tier 1, Evon v3.3 on vLLM (rented GPU):
#   PERSONA_LLM_BASE_URL=http://<gpu-host>:8000/v1
#   PERSONA_LLM_MODEL=gnani/gnani-evon-v3.3-30B-A3B
#   PERSONA_LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# Tier 2, Evon GGUF on Ollama:  http://localhost:11434/v1  (model = your local tag)
# Tier 3, any hosted OpenAI-compatible LLM. Free-tier setup verified live on 2026-11-05 (docs/LIVE_STATUS.md):
#   All three on Groq (key from console.groq.com): 1,000 requests/day per model, 8k tokens/min
#     *_LLM_BASE_URL=https://api.groq.com/openai/v1
#     PERSONA_LLM_MODEL=openai/gpt-oss-20b
#     BOT_LLM_MODEL=qwen/qwen3.8-27b
#     JUDGE_LLM_MODEL=openai/gpt-oss-120b      # a different family from the bot
#   Google Gemini free tier is only 20 requests/day per model (~4 calls), too little for a matrix:
#     *_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     *_LLM_MODEL=gemini-3.5-flash-lite        # gemini-2.5-flash is retired; 3.7/3.8 Flash were often 503
PERSONA_LLM_BASE_URL=
PERSONA_LLM_MODEL=
PERSONA_LLM_API_KEY=
PERSONA_LLM_EXTRA_BODY=

# The reference bot's brain
BOT_LLM_BASE_URL=
BOT_LLM_MODEL=
BOT_LLM_API_KEY=
BOT_LLM_EXTRA_BODY=

# The judge: MUST be a different model from BOT_LLM
JUDGE_LLM_BASE_URL=
JUDGE_LLM_MODEL=
JUDGE_LLM_API_KEY=
JUDGE_LLM_EXTRA_BODY=
# Set to false if your server rejects response_format=json_object
# JUDGE_LLM_JSON_MODE=false

# ---- Misc ------------------------------------------------------------------
# CHAKRAVYUH_OFFLINE=1        # dry run with simulated STT/TTS (results meaningless)
# CHAKRAVYUH_REEL_FONT=Nirmala UI

# Optional second judge: Gnani Evon v3.3 running locally (docs/EVON_LOCAL.md)
EVON_LLM_BASE_URL=
EVON_LLM_MODEL=
EVON_LLM_API_KEY=
EVON_LLM_EXTRA_BODY=
