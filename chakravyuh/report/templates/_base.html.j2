<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}CHAKRAVYUH{% endblock %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&family=Noto+Sans+Devanagari:wght@400;500;600&family=Noto+Sans+Tamil:wght@400;500&family=Noto+Sans+Kannada:wght@400;500&display=swap" rel="stylesheet">
<script>try{var t=localStorage.getItem("ck-theme");if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
<style>
:root{color-scheme:light;
  --bg:#f4f2ec;--surface:#fff;--surface-2:#faf9f5;--ink:#141412;--ink-2:#3b3a35;--muted:#75716a;--line:#e5e1d7;--line-2:#d6d0c2;
  --accent:#f2b90f;--accent-soft:#fcf1cc;--accent-ink:#1b1605;--link:#7d5300;
  --fail:#c42f1b;--fail-soft:#fbe8e3;--fail-line:#f1c2b8;--pass:#16754a;--pass-soft:#e2f1e8;--pass-line:#b8dcc7;
  --warn:#9a6200;--warn-soft:#fbefd4;--warn-line:#ecd29a;
  --shadow:0 1px 0 rgba(20,20,18,.04),0 1px 3px rgba(20,20,18,.06);--shadow-lg:0 1px 0 rgba(20,20,18,.04),0 12px 32px -12px rgba(20,20,18,.18);
  --sans:"Geist","Noto Sans Devanagari","Noto Sans Tamil","Noto Sans Kannada","Nirmala UI",system-ui,sans-serif;
  --mono:"Geist Mono",ui-monospace,SFMono-Regular,Consolas,monospace;
  --r:14px;--r-sm:9px;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;
  --bg:#0f0f0d;--surface:#181816;--surface-2:#1e1e1b;--ink:#f2f0ea;--ink-2:#d2cfc6;--muted:#9a968c;--line:#2b2a26;--line-2:#3a3833;
  --accent:#f5c43a;--accent-soft:#2c2510;--accent-ink:#1b1605;--link:#f5c43a;
  --fail:#ff6d58;--fail-soft:#2d1612;--fail-line:#5a2a22;--pass:#4cc98a;--pass-soft:#11271b;--pass-line:#1f4a33;
  --warn:#f0b24a;--warn-soft:#2b210f;--warn-line:#54401b;--shadow:none;--shadow-lg:0 12px 32px -12px rgba(0,0,0,.6)}}
:root[data-theme="dark"]{color-scheme:dark;
  --bg:#0f0f0d;--surface:#181816;--surface-2:#1e1e1b;--ink:#f2f0ea;--ink-2:#d2cfc6;--muted:#9a968c;--line:#2b2a26;--line-2:#3a3833;
  --accent:#f5c43a;--accent-soft:#2c2510;--accent-ink:#1b1605;--link:#f5c43a;
  --fail:#ff6d58;--fail-soft:#2d1612;--fail-line:#5a2a22;--pass:#4cc98a;--pass-soft:#11271b;--pass-line:#1f4a33;
  --warn:#f0b24a;--warn-soft:#2b210f;--warn-line:#54401b;--shadow:none;--shadow-lg:0 12px 32px -12px rgba(0,0,0,.6)}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 var(--sans);-webkit-font-smoothing:antialiased;font-feature-settings:"ss01"}
a{color:var(--link);text-decoration:none}a:hover{text-decoration:underline;text-underline-offset:3px}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}
.mono{font-family:var(--mono);font-size:.86em;letter-spacing:-.01em}
.muted{color:var(--muted)}
.num{font-variant-numeric:tabular-nums}

/* top bar */
.top{position:sticky;top:0;z-index:10;background:color-mix(in srgb,var(--bg) 82%,transparent);backdrop-filter:saturate(1.4) blur(12px);-webkit-backdrop-filter:saturate(1.4) blur(12px);border-bottom:1px solid var(--line)}
.top-in{max-width:1180px;margin:0 auto;padding:12px 24px;display:flex;align-items:center;gap:28px}
.brand{display:flex;align-items:center;gap:10px;color:var(--ink)}.brand:hover{text-decoration:none}
.brand svg{width:26px;height:26px;flex:none}
.word{font-family:var(--mono);font-weight:600;font-size:14px;letter-spacing:.14em}
.brand .tag{font-size:12px;color:var(--muted);border-left:1px solid var(--line-2);padding-left:10px;margin-left:2px}
.nav{display:flex;gap:4px}
.nav a{color:var(--ink-2);font-size:13.5px;font-weight:500;padding:6px 11px;border-radius:8px}
.nav a:hover{background:var(--surface);text-decoration:none}.nav a.on{background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}
.top-r{margin-left:auto;display:flex;align-items:center;gap:10px}
.live{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:500;color:var(--ink-2);padding:5px 10px;border:1px solid var(--line);border-radius:99px;background:var(--surface)}
.live i{width:7px;height:7px;border-radius:50%;background:var(--pass);box-shadow:0 0 0 3px var(--pass-soft)}
.live.off i{background:var(--warn);box-shadow:0 0 0 3px var(--warn-soft)}
.iconbtn{width:34px;height:34px;display:grid;place-items:center;border-radius:9px;border:1px solid var(--line);background:var(--surface);color:var(--ink-2);cursor:pointer}
.iconbtn:hover{color:var(--ink);border-color:var(--line-2)}.iconbtn svg{width:16px;height:16px}

/* page */
main{max-width:1180px;margin:0 auto;padding:40px 24px 72px}
.eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.eyebrow b{color:var(--ink);font-weight:600}
.dot{width:4px;height:4px;border-radius:50%;background:var(--line-2);display:inline-block}
h1{font-size:40px;line-height:1.08;letter-spacing:-.03em;font-weight:650;margin:12px 0 10px}
h1 .soft{color:var(--muted);font-weight:500}
.lead{font-size:17px;color:var(--ink-2);max-width:720px;margin:0}
.specs{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
.spec{display:inline-flex;gap:8px;align-items:baseline;font-size:12.5px;padding:6px 10px;border-radius:8px;background:var(--surface);border:1px solid var(--line)}
.spec span{font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.spec b{font-weight:500;font-family:var(--mono);font-size:12px}

.sec{margin:56px 0 18px;display:grid;grid-template-columns:auto 1fr;column-gap:14px;align-items:baseline}
.sec .k{font-family:var(--mono);font-size:12px;color:var(--muted);border:1px solid var(--line-2);border-radius:6px;padding:1px 6px}
.sec h2{font-size:22px;letter-spacing:-.02em;font-weight:620;margin:0}
.sec p{grid-column:2;margin:4px 0 0;color:var(--muted);font-size:14px;max-width:760px}

.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow)}
.pad{padding:20px 22px}
.scroll{overflow-x:auto}

/* KPI tiles */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(196px,1fr));gap:14px;margin-top:32px}
.kpi{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:18px 18px 16px;box-shadow:var(--shadow);overflow:hidden}
.kpi .lbl{font-size:12.5px;color:var(--muted);font-weight:500;display:flex;align-items:center;gap:7px}
.kpi .lbl svg{width:14px;height:14px}
.kpi .val{font-size:38px;line-height:1.05;letter-spacing:-.035em;font-weight:620;margin:12px 0 6px;font-variant-numeric:tabular-nums}
.kpi .val small{font-size:18px;color:var(--muted);font-weight:500;letter-spacing:-.01em}
.kpi .foot{font-size:12px;color:var(--muted)}
.kpi.danger{border-color:var(--fail-line);background:linear-gradient(180deg,var(--fail-soft),var(--surface) 70%)}
.kpi.danger .val,.kpi.danger .lbl{color:var(--fail)}
.kpi.good .val{color:var(--pass)}
.kpi.danger::before,.kpi.good::before,.kpi.hero::before{content:"";position:absolute;inset:0 auto 0 0;width:3px;background:var(--fail)}
.kpi.good::before{background:var(--pass)}.kpi.hero::before{background:var(--accent)}
.ci{position:relative;height:6px;border-radius:99px;background:var(--surface-2);border:1px solid var(--line);margin:10px 0 8px}
.ci-band{position:absolute;top:-1px;bottom:-1px;border-radius:99px;background:var(--accent-soft);border:1px solid var(--accent)}
.ci-dot{position:absolute;top:50%;width:11px;height:11px;margin:-5.5px 0 0 -5.5px;border-radius:50%;background:var(--ink);border:2px solid var(--surface)}

/* badges & chips */
.badge{display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.1em;padding:4px 9px;border-radius:6px;text-transform:uppercase;white-space:nowrap}
.badge.fail{background:var(--fail);color:#fff}.badge.pass{background:var(--pass);color:#fff}.badge.warn{background:var(--warn-soft);color:var(--warn);border:1px solid var(--warn-line)}
.chip{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:500;padding:3px 9px;border-radius:99px;background:var(--surface-2);border:1px solid var(--line);color:var(--ink-2);white-space:nowrap}
.chip svg{width:12px;height:12px}
.chip.f{background:var(--fail-soft);border-color:var(--fail-line);color:var(--fail)}
.chip.p{background:var(--pass-soft);border-color:var(--pass-line);color:var(--pass)}

/* matrix */
.matrix{width:100%;border-collapse:separate;border-spacing:10px}
.matrix th{font-size:12px;font-weight:500;color:var(--muted);text-align:left;padding:0 6px;font-family:var(--mono);letter-spacing:.04em;text-transform:uppercase}
.matrix td.who{font-weight:600;font-size:14.5px;padding-right:10px;white-space:nowrap}
.matrix td.who small{display:block;font-weight:400;color:var(--muted);font-size:12px;font-family:var(--mono)}
.tile{border-radius:12px;padding:14px;min-width:190px;border:1px solid var(--line);background:var(--surface-2)}
.tile .t-top{display:flex;align-items:center;justify-content:space-between;gap:8px}
.tile .t-seeds{font-family:var(--mono);font-size:12px;color:var(--muted)}
.tile .t-chips{display:flex;flex-wrap:wrap;gap:5px;margin-top:10px}
.tile.fail{background:var(--fail-soft);border-color:var(--fail-line)}
.tile.pass{background:var(--pass-soft);border-color:var(--pass-line)}
.tile.na{display:grid;place-items:center;color:var(--muted);min-height:58px;border-style:dashed;background:transparent}

/* failure cards */
.fcard{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);margin-bottom:18px;overflow:hidden}
.fhead{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:16px 20px;border-bottom:1px solid var(--line);background:var(--surface-2)}
.fhead h3{margin:0;font-size:16px;font-weight:600;letter-spacing:-.01em}
.fhead h3 .arr{color:var(--muted);font-weight:400;margin:0 6px}
.fhead .fmeta{margin-left:auto;display:flex;gap:6px;flex-wrap:wrap}
.fbody{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(280px,1fr)}
.checks{padding:6px 20px 14px}
.check{padding:14px 0;border-bottom:1px solid var(--line)}
.check:last-child{border-bottom:0}
.check-top{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
.check-top .x{width:20px;height:20px;border-radius:6px;display:grid;place-items:center;background:var(--fail-soft);color:var(--fail);flex:none}
.check-top .x.u{background:var(--warn-soft);color:var(--warn)}
.check-top .x svg{width:12px;height:12px}
.check-top b{font-size:14.5px;font-weight:600}
.src{font-family:var(--mono);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);border:1px solid var(--line);border-radius:5px;padding:2px 6px;display:inline-flex;align-items:center;gap:4px}
.src svg{width:11px;height:11px;color:var(--pass)}
.reason{margin:6px 0 0 29px;color:var(--ink-2);font-size:14px}
.quote{margin:10px 0 0 29px;padding:10px 14px;border-radius:10px;background:var(--surface-2);border:1px solid var(--line);position:relative}
.quote::before{content:"";position:absolute;left:-1px;top:10px;bottom:10px;width:3px;border-radius:3px;background:var(--fail)}
.quote figcaption{font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
.quote blockquote{margin:0;font-size:14.5px;line-height:1.6}
.same{margin:8px 0 0 29px;font-family:var(--mono);font-size:11.5px;color:var(--muted)}
.quote .qd{font-family:var(--mono);font-size:12px;color:var(--fail);margin-top:4px}
mark{background:var(--accent-soft);color:inherit;border-radius:3px;padding:0 2px;box-shadow:inset 0 -2px 0 var(--accent)}
.listen{border-left:1px solid var(--line);padding:16px 20px;background:linear-gradient(180deg,var(--surface-2),var(--surface))}
.listen-h{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);display:flex;align-items:center;gap:8px;margin-bottom:12px}
.listen-h svg{width:14px;height:14px;color:var(--ink)}
.track{border:1px solid var(--line);border-radius:12px;background:var(--surface);padding:10px 12px;margin-bottom:10px}
.track .tl{font-size:12px;font-weight:600;margin-bottom:6px;display:flex;justify-content:space-between}
.track .tl span{font-weight:400;color:var(--muted);font-family:var(--mono);font-size:11px}
.track .row{display:grid;grid-template-columns:86px 1fr;align-items:center;gap:8px;margin-top:4px}
.track .row > span{font-size:11.5px;color:var(--muted)}
audio{width:100%;height:34px;accent-color:var(--accent)}
details.tx{border-top:1px solid var(--line)}
details.tx summary{list-style:none;cursor:pointer;padding:13px 20px;font-size:13.5px;font-weight:550;color:var(--ink-2);display:flex;align-items:center;gap:8px}
details.tx summary::-webkit-details-marker{display:none}
details.tx summary svg{width:14px;height:14px;transition:transform .18s ease}
details.tx[open] summary svg{transform:rotate(90deg)}
details.tx summary:hover{color:var(--ink);background:var(--surface-2)}
.chat{padding:6px 20px 22px;display:flex;flex-direction:column;gap:12px}
.msg{max-width:78%;padding:10px 14px;border-radius:14px;font-size:14px;line-height:1.55}
.msg .who{font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:3px;display:flex;gap:8px}
.msg.caller{align-self:flex-start;background:var(--surface-2);border:1px solid var(--line);border-top-left-radius:4px}
.msg.bot{align-self:flex-end;background:var(--accent-soft);border:1px solid color-mix(in srgb,var(--accent) 45%,var(--line));border-top-right-radius:4px}
.msg .heard{margin-top:6px;padding-top:6px;border-top:1px dashed var(--line-2);font-size:12.5px;color:var(--muted)}
.msg .meta{margin-top:6px;font-family:var(--mono);font-size:11px;color:var(--muted)}

/* tables */
.tbl{width:100%;border-collapse:collapse}
.tbl th{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:500;text-align:left;padding:12px 16px;border-bottom:1px solid var(--line);background:var(--surface-2)}
.tbl td{padding:14px 16px;border-bottom:1px solid var(--line);vertical-align:middle;font-size:14px}
.tbl tr:last-child td{border-bottom:0}
.bar{height:8px;border-radius:99px;background:var(--surface-2);border:1px solid var(--line);overflow:hidden;min-width:120px}
.bar i{display:block;height:100%;background:var(--ink);border-radius:99px}
.bar.f i{background:var(--fail)}

/* method */
.method{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:14px}
.mitem{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px}
.mitem b{display:flex;align-items:center;gap:8px;font-size:14px;margin-bottom:6px}
.mitem b svg{width:16px;height:16px;color:var(--ink)}
.mitem p{margin:0;font-size:13.5px;color:var(--muted)}

.banner{display:flex;gap:10px;align-items:center;background:var(--warn-soft);color:var(--warn);border:1px solid var(--warn-line);padding:12px 16px;border-radius:12px;font-weight:600;margin:0 0 24px}
footer{border-top:1px solid var(--line);margin-top:72px}
.foot-in{max-width:1180px;margin:0 auto;padding:22px 24px 40px;display:flex;gap:16px;align-items:center;flex-wrap:wrap;font-size:13px;color:var(--muted)}
.foot-in .brand svg{width:18px;height:18px}
.foot-in .r{margin-left:auto}
{% block extra_css %}{% endblock %}
@media (max-width:860px){
  .fbody{grid-template-columns:1fr}.listen{border-left:0;border-top:1px solid var(--line)}
  .brand .tag,.live{display:none}h1{font-size:30px}.top-in{gap:14px;padding:10px 16px}main{padding:28px 16px 56px}
  .msg{max-width:92%}.reason,.quote{margin-left:0}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
{% set mark %}<svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="15" fill="var(--ink)"/><path d="M16 16V1A15 15 0 0 0 1 16Z" fill="var(--accent)"/><path d="M16 16v15a15 15 0 0 0 15-15Z" fill="var(--accent)"/><circle cx="16" cy="16" r="15" fill="none" stroke="var(--ink)" stroke-width="1"/></svg>{% endset %}
<header class="top"><div class="top-in">
  <a class="brand" href="{{ (root ~ 'index.html') if root is not none else repo_url }}">{{ mark|safe }}<span class="word">CHAKRAVYUH</span><span class="tag">crash-test lab for Indian voice bots</span></a>
  <nav class="nav" aria-label="Pages">
    {% if root is not none %}<a href="{{ root }}index.html" class="{{ 'on' if page == 'index' else '' }}">Overview</a>
    {% if nav_diff %}<a href="{{ root }}diff.html" class="{{ 'on' if page == 'diff' else '' }}">v1 → v2</a>{% endif %}{% endif %}
    <a href="{{ repo_url }}">GitHub</a>
  </nav>
  <div class="top-r">
    <span class="live {{ 'off' if offline else '' }}"><i></i>{{ 'Offline dry run' if offline else 'Live · Gnani APIs' }}</span>
    <button class="iconbtn" type="button" aria-label="Toggle light or dark theme" onclick="var d=document.documentElement,n=(d.dataset.theme||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'))==='dark'?'light':'dark';d.dataset.theme=n;try{localStorage.setItem('ck-theme',n)}catch(e){}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
  </div>
</div></header>
<main>
{% if offline %}<div class="banner">OFFLINE DRY RUN: simulated speech and transcription, scripted callers. These numbers are meaningless; they only prove the pipeline runs.</div>{% endif %}
{% block body %}{% endblock %}
</main>
<footer><div class="foot-in"><span class="brand">{{ mark|safe }}<span class="word" style="font-size:12px">CHAKRAVYUH</span></span><span>Crash-test dummies for Indian voice bots. Built on Gnani Prisma (STT) and Timbre (TTS). All callers, names and identifiers are synthetic.</span><a class="r" href="{{ repo_url }}">Source on GitHub →</a></div></footer>
</body></html>
